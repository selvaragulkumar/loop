# Advanced Agent Loop — Configuration
# Copy this file to .env and fill in your values, or export these as environment variables.

# ── Required ──────────────────────────────────────────────────
# LLM API endpoint (any OpenAI-compatible server: vLLM, Ollama, OpenAI, etc.)
OPENAI_BASE_URL=http://localhost:8000/v1

# Model ID as it appears on your server
OPENAI_MODEL=your-model-id

# API key (leave empty if your server doesn't require auth)
AGENT_API_KEY=

# ── Optional Overrides ────────────────────────────────────────
# All of these are auto-detected or auto-scaled from the model's context window.
# Only set them if you need to override the defaults.

# AGENT_CONTEXT_WINDOW=32000        # Override auto-detected context window (tokens)
# AGENT_MAX_OUTPUT=4096             # Max output tokens per LLM call
# AGENT_TEMPERATURE=0.2            # Sampling temperature
# AGENT_MAX_STEPS=0                # Hard step limit (0 = unlimited)
# AGENT_MAX_ERRORS=8               # Consecutive errors before termination

# ── Memory & Compaction ───────────────────────────────────────
# AGENT_MEMORY_WINDOW=20           # Steps kept in working memory
# AGENT_COMPACT_THRESHOLD=20000    # Char threshold for compaction
# AGENT_COMPACT_INTERVAL=15        # Steps between compaction checks

# ── Feature Toggles ──────────────────────────────────────────
# AGENT_ENABLE_STAGES=true         # Enable 6-phase stage system (intake→finalization)
# AGENT_REQUIRE_SMOKE_TEST=true    # Require smoke test before finish (set false for chatbot/non-build tasks)
# AGENT_NO_THINKING=1              # Disable thinking tokens (needed for Qwen3, some MiniMax models)

# ── Command Allowlist ─────────────────────────────────────────
# Add extra command prefixes your project needs (comma-separated).
# Built-in: npm, node, python, git, cargo, go, make, docker, curl, and common shell utils.
# AGENT_ALLOWED_COMMANDS=kubectl ,terraform ,ansible
